    "@agent-qofeno/config": "0.1.0",
    "@agent-qofeno/session": "0.1.0",
    "@agent-qofeno/knowledge": "0.1.0",
    "@agent-qofeno/ctx": "0.1.0",
    "@agent-qofeno/tools": "0.1.1",
    "@agent-qofeno/agents": "0.1.0",
    "@agent-qofeno/workflows": "0.1.0",
